# ==========================================
# CGE-P Labs Global Gitignore
# ==========================================

# --- Terraform / Infrastructure as Code ---
.terraform/
*.tfstate
*.tfstate.*
crash.log
crash.*.log
*.tfvars
*.tfvars.json
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraform.lock.hcl
tfplan
*.tfplan

# --- Open Policy Agent (OPA) / Rego ---
*.yaml.json
*.yml.json

# --- CI/CD & Local Runner Testing ---
.act/
.github/local-runner/
.gitlab-runner/

# --- Secrets, Credentials, & Environment Variables ---
.env
.env.*
*.pem
*.key
*.pub
*.pkcs12
*.pfx
secrets.xml
credentials.json
.vault-token

# --- Operating System & Editor Artifacts ---
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
.envrc
.direnv/
